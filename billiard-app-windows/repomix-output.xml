<script>
  import { createEventDispatcher } from 'svelte';
  import { X, ZoomIn, ZoomOut, Upload, Link, Check } from 'lucide-svelte';

  export let initialImage = '';
  const dispatch = createEventDispatcher();

  let mode = 'file';
  let imageUrl = initialImage;
  let customUrl = '';
  let zoom = 1;
  let panX = 0;
  let panY = 0;
  let isDragging = false;
  let startX = 0;
  let startY = 0;

  let canvas;
  let imgElement;

  function handleFileSelect(e) {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        imageUrl = event.target.result;
        zoom = 1;
        panX = 0;
        panY = 0;
      };
      reader.readAsDataURL(file);
    }
  }

  function handleUrlApply() {
    if (customUrl.trim()) {
      imageUrl = customUrl.trim();
      zoom = 1;
      panX = 0;
      panY = 0;
    }
  }

  function onMouseDown(e) {
    isDragging = true;
    startX = e.clientX - panX;
    startY = e.clientY - panY;
  }

  function onMouseMove(e) {
    if (!isDragging) return;
    panX = Math.max(-100, Math.min(100, e.clientX - startX));
    panY = Math.max(-100, Math.min(100, e.clientY - startY));
  }

  function onMouseUp() {
    isDragging = false;
  }

  function saveCrop() {
    try {
      const ctx = canvas.getContext('2d');
      canvas.width = 160;
      canvas.height = 160;

      ctx.clearRect(0, 0, 160, 160);
      ctx.save();
      ctx.beginPath();
      ctx.arc(80, 80, 80, 0, Math.PI * 2);
      ctx.closePath();
      ctx.clip();

      if (imgElement && imgElement.complete) {
        const aspect = imgElement.naturalWidth / imgElement.naturalHeight;
        let drawW = 160 * zoom;
        let drawH = (160 / aspect) * zoom;
        let drawX = 80 - drawW / 2 + panX;
        let drawY = 80 - drawH / 2 + panY;

        ctx.drawImage(imgElement, drawX, drawY, drawW, drawH);
      }
      ctx.restore();

      // Intento exportar Base64
      const croppedDataUrl = canvas.toDataURL('image/png');
      dispatch('save', croppedDataUrl);
    } catch (err) {
      // Si el navegador bloquea el canvas por CORS de Google, guardamos la URL directamente
      console.warn('Canvas bloqueado por CORS, guardando URL directa:', err);
      dispatch('save', imageUrl);
    }
  }
</script>

