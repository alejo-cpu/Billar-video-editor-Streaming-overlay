    {:else}
      <div class="flex gap-2">
        <input type="text" bind:value={customUrl} placeholder="https://ejemplo.com/foto.png" class="flex-1 bg-[#090b10] border border-neutral-700 rounded-lg px-3 py-1.5 text-xs text-white outline-none focus:border-amber-500" />
        <button on:click={handleUrlApply} class="px-3 py-1.5 bg-neutral-800 hover:bg-neutral-700 text-xs font-bold rounded-lg transition">Cargar</button>
      </div>
    {/if}

    <!-- Vista previa circular interactiva -->
    <div class="flex flex-col items-center justify-center my-2">
      <p class="text-[11px] text-neutral-400 mb-2">Arrastrá para reubicar la imagen en el círculo</p>
      <div
        class="w-44 h-44 rounded-full border-2 border-amber-400 overflow-hidden relative bg-black cursor-grab active:cursor-grabbing select-none shadow-[0_0_15px_rgba(245,158,11,0.3)]"
        on:mousedown={onMouseDown}
        on:mousemove={onMouseMove}
        on:mouseup={onMouseUp}
      >
        <img
          bind:this={imgElement}
          src={imageUrl}
          crossorigin="anonymous"
          alt="Crop preview"
          class="absolute max-w-none pointer-events-none transition-transform duration-75"
          style="
            transform: translate(calc(-50% + {panX}px), calc(-50% + {panY}px)) scale({zoom});
            top: 50%;
            left: 50%;
            width: 176px;
          "
        />
      </div>
    </div>

    <!-- Controles de Zoom -->
    <div class="flex items-center gap-3 px-2">
      <ZoomOut size={16} class="text-neutral-400" />
      <input
        type="range"
        min="0.8"
        max="2.5"
        step="0.05"
        bind:value={zoom}
        class="flex-1 accent-amber-500 h-1.5 bg-neutral-800 rounded-lg cursor-pointer"
      />
      <ZoomIn size={16} class="text-neutral-400" />
      <span class="text-xs font-mono text-neutral-400 w-10 text-right">{Math.round(zoom * 100)}%</span>
    </div>

    <canvas bind:this={canvas} class="hidden"></canvas>

    <div class="flex items-center justify-end gap-3 pt-3 border-t border-white/10">
      <button on:click={() => dispatch('close')} class="px-4 py-2 text-xs font-bold text-neutral-400 hover:text-white transition">Cancelar</button>
      <button on:click={saveCrop} class="px-5 py-2 bg-amber-500 hover:bg-amber-400 text-black text-xs font-black rounded-lg flex items-center gap-1.5 transition shadow-lg active:scale-95">
        <Check size={16} /> Guardar foto
      </button>
    </div>

  </div>
</div>
